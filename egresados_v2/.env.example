# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el .env real al repositorio (está en .gitignore).

# Entorno: development | production
# En produccion siempre "production" (oculta errores al visitante)
APP_ENV=development

# Hosts permitidos separados por coma (mitiga Host Header attacks).
# En produccion pon tu dominio real, ej: egresados.miinst.edu.co,www.miinst.edu.co
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_NAME=bd_egresados
DB_USER=TU_USUARIO_BD
DB_PASS=TU_CLAVE_BD