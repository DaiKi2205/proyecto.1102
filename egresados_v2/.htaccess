# ======================================================================
#  Configuración de producción — Apache (hosting compartido)
#  Aplicable también en XAMPP (XAMPP permite .htaccess por defecto).
# ======================================================================

# No permitir listado de directorios
Options -Indexes

# Codificación por defecto
AddDefaultCharset UTF-8

# ----------------------------------------------------------------------
#  Cabeceras de seguridad HTTP
# ----------------------------------------------------------------------
<IfModule mod_headers.c>

    # Fuerza HTTPS (mina HSTS se envía solo cuando hay HTTPS activo)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Bloquea la carga del sitio dentro de <iframe> (clickjacking)
    Header always set X-Frame-Options "DENY"

    # Evita MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Política de referrer: no enviar datos sensibles a terceros
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Aislamiento de procesos de cliente (Cross-Origin)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # CORS: por defecto SOLO mismo origen. Sin comodines.
    # (No se definen cabeceras Access-Control-Allow-*: la API es misma-origen.)

    # Content-Security-Policy
    # El sitio usa estilos y scripts inline (oninput/onclick/etiqueta <style>/<script>),
    # por eso se permiten 'unsafe-inline' para script/style, pero se bloquean
    # recursos externos, <object>/<embed> y la carga en iframes (frame-ancestors).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

    # Ocultar versión de servidor/tecnología
    Header always unset X-Powered-By
    Header always unset Server

</IfModule>

# ----------------------------------------------------------------------
#  Protección de archivos sensibles
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # .env, dumps .sql, .git, logs y archivos ocultos: denegar 404
    RewriteRule ^\.env$ - [R=404,L]
    RewriteRule ^\.env\.(example|local)$ - [R=404,L]
    RewriteRule ^(.*\.sql|.*\.log)$ - [R=404,L]
    RewriteRule ^(\.git|logs)/ - [R=404,L]
    RewriteRule ^img/LEEME\.txt$ - [R=404,L]
</IfModule>

# Acceso directo a archivos ocultos (punto inicial) -> 404
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Los archivos de config/ (db.php, env.php, helpers.php...) solo se usan
# via include de PHP; cualquier request HTTP a ellos -> 404.
# (api/ sigue accesible: es el endpoint público del formulario.)
RewriteRule ^config/ - [R=404,L]

# ----------------------------------------------------------------------
#  Compresión de contenido (gzip)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

# ----------------------------------------------------------------------
#  Caché de estáticos (favorece el rendimiento)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresDefault "access plus 1 hour"
</IfModule>

# ----------------------------------------------------------------------
#  Páginas de error personalizadas
# ----------------------------------------------------------------------
ErrorDocument 400 /404.php
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 503 /500.php